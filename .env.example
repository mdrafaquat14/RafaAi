# Browser/public config only. Never put AI provider API keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: defaults to /functions/v1/rafaai-chat on your Supabase project.
VITE_RAFAAI_FUNCTION_NAME=rafaai-chat

# Server-side Supabase Edge Function secrets (set in Supabase, NOT Vercel/browser):
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# CEREBRAS_API_KEY=...
#
# Optional server-side model overrides:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
# CEREBRAS_MODEL=gpt-oss-120b
